# Copy to .env for local development. On Vercel, set these in Project → Settings → Environment Variables.

DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# Neon Postgres connection string (leave empty locally to use SQLite)
DATABASE_URL=

# Optional: Google sign-in (Google Cloud Console → OAuth client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: AI features
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
AI_DAILY_LIMIT=10
